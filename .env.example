# MySQL
MYSQL_ROOT_PASSWORD=

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_HOST=
SAVING_BOT_CHAT_TTL_SECONDS=259200
SAVING_BOT_CHAT_MAX_MESSAGES=100

# OpenAI
OPEN_AI_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Development Fixture mode (never enable in production)
# fixture: fixed transaction data instead of OpenAI synthetic data
MYDATA_TRANSACTION_SOURCE=openai

# Development challenge clock (ignored when NODE_ENV=production)
# Saturday demo example: 2026-08-01T00:01:00+09:00
CHALLENGE_TEST_NOW=

# Koscom CHECK API
CUST_ID=
AUTH_KEY=
# Local backend only: route CHECK calls through the production backend's fixed IP.
KOSCOM_PROXY_URL=https://kospay.p-e.kr/api/internal/koscom/check
KOSCOM_MISSING_BASE_PRICE_SYNC_INTERVAL_MS=600000
KOSCOM_MISSING_BASE_PRICE_SYNC_LIMIT=60
OPENAI_SAVING_VECTOR_STORE_ID=
